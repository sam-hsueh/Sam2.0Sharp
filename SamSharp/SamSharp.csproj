<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Sam2Sharp</PackageId>
    <Version>1.0.0</Version>
    <Product>Sam2.0Sharp</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude all existing C# source files in this project to allow a minimal stub build.
         This makes the SamSharp project act as a placeholder while the Benchmark project
         uses its own local stubs. Remove this override when restoring full library sources. -->
    <Compile Remove="**\*.cs" />
    <Compile Remove="Modeling\sam\**" />
    <EmbeddedResource Remove="Modeling\sam\**" />
    <None Remove="Modeling\sam\**" />
    <Compile Include="Sam2AutomaticMaskGenerator.cs" />
    <Compile Include="Compat.cs" />
    <Compile Include="Lib.cs" />
    <Compile Include="Modeling\backbones\hieradet.cs" />
    <Compile Include="Modeling\backbones\image_encoder.cs" />
    <Compile Include="Modeling\backbones\utils.cs" />
    <Compile Include="Modeling\Common.cs" />
    <Compile Include="Modeling\memory_attention.cs" />
    <Compile Include="Modeling\memory_encoder.cs" />
    <Compile Include="Modeling\position_encoding.cs" />
    <Compile Include="Modeling\sam2_base.cs" />
    <Compile Include="Modeling\sam2_utils.cs" />
    <Compile Include="Modeling\sam2\mask_decoder.cs" />
    <Compile Include="Modeling\sam2\prompt_encoder.cs" />
    <Compile Include="Modeling\sam2\transformer.cs" />
    <Compile Include="sam2_image_predictor.cs" />
    <Compile Include="sam2_video_predictor.cs" />
    <Compile Include="Tools\ImageTools.cs" />
    <Compile Include="Tools\PickleLoader.cs" />
    <Compile Include="Tools\TensorTools.cs" />
    <Compile Include="Utils\Amg.cs" />
    <Compile Include="Utils\BuildSam.cs" />
    <Compile Include="Utils\Misc.cs" />
    <Compile Include="Utils\SAM2Transforms.cs" />
    <Compile Include="Utils\Classes.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TorchSharp-main\TorchSharp-main\src\TorchSharp\TorchSharp.csproj" />
    <ProjectReference Include="..\..\TorchSharp-main\TorchSharp-main\src\TorchVision\TorchVision.csproj" />
  </ItemGroup>

</Project>










